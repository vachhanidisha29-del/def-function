   "source": [
    "if bill > 5000:\n",
    "    discount = bill * 20 / 100\n",
    "elif bill > 3000:\n",
    "    discount = bill * 10 / 100\n",
    "else:\n",
    "    discount = 0\n",
    "\n",
    "final_amount = bill - discount\n",
    "\n",
    "print(\"Discount:\", discount)\n",
    "print(\"Final Bill:\", final_amount)"
